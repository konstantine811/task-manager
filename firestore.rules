rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email in [
          "constainabrams@gmail.com",
          "constainabrams@gmial.com"
        ];
    }

    function billingDoc(uid) {
      return get(/databases/$(database)/documents/billingUsers/$(uid));
    }

    function hasTimestampField(doc, field) {
      return field in doc.data && doc.data[field] is timestamp;
    }

    function hasActiveTrial(uid) {
      return exists(/databases/$(database)/documents/billingUsers/$(uid)) &&
        hasTimestampField(billingDoc(uid), "trialEndsAt") &&
        billingDoc(uid).data.trialEndsAt > request.time;
    }

    function hasActivePaidAccess(uid) {
      return exists(/databases/$(database)/documents/billingUsers/$(uid)) &&
        hasTimestampField(billingDoc(uid), "accessEndsAt") &&
        billingDoc(uid).data.accessEndsAt > request.time;
    }

    function hasAdminAccess(uid) {
      return isAdminEmail() ||
        (
          exists(/databases/$(database)/documents/billingUsers/$(uid)) &&
          "adminAccess" in billingDoc(uid).data &&
          billingDoc(uid).data.adminAccess == true
        );
    }

    function hasAppAccess(uid) {
      return isOwner(uid) &&
        (hasAdminAccess(uid) || hasActiveTrial(uid) || hasActivePaidAccess(uid));
    }

    function validDayId(date) {
      return date.matches("^\\d{4}-\\d{2}-\\d{2}$") ||
        date.matches("^\\d{2}\\.\\d{2}\\.\\d{4}$");
    }

    function safeUserDocWrite() {
      return request.resource.data.keys().hasOnly([
        "email",
        "items",
        "updatedAt",
        "timerState",
        "timeZone",
        "timeZoneOffsetMinutes",
        "goals"
      ]);
    }

    function safeDayDocWrite() {
      return request.resource.data.keys().hasOnly([
        "email",
        "items",
        "updatedAt",
        "timerState",
        "timeZone",
        "timeZoneOffsetMinutes"
      ]);
    }

    match /template-tasks/{uid} {
      allow read: if hasAppAccess(uid);
      allow create, update: if hasAppAccess(uid) && safeUserDocWrite();
      allow delete: if false;
    }

    match /daily-tasks/{uid}/days/{date} {
      allow read, list: if hasAppAccess(uid) && validDayId(date);
      allow create, update: if hasAppAccess(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if false;
    }

    match /planned-tasks/{uid}/days/{date} {
      allow read, list: if hasAppAccess(uid) && validDayId(date);
      allow create, update: if hasAppAccess(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if hasAppAccess(uid) && validDayId(date);
    }

    match /daily-analytics/{uid}/days/{date} {
      allow read, list: if hasAppAccess(uid) && validDayId(date);
      allow create, update: if hasAppAccess(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if false;
    }

    match /daily-journal/{uid}/days/{date} {
      allow read, list: if hasAppAccess(uid) && validDayId(date);
      allow create, update: if hasAppAccess(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if hasAppAccess(uid) && validDayId(date);
    }

    match /task-instances/{uid}/days/{date} {
      allow read, list: if hasAppAccess(uid) && validDayId(date);
      allow create, update: if hasAppAccess(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if false;
    }

    match /goals/{uid} {
      allow read: if hasAppAccess(uid);
      allow create, update: if hasAppAccess(uid) && safeUserDocWrite();
      allow delete: if false;
    }

    match /goal-progress-events/{uid}/events/{eventId} {
      allow read, list: if hasAppAccess(uid);
      allow create, update: if hasAppAccess(uid) && request.resource.data.keys().hasOnly([
        "email",
        "items",
        "updatedAt",
        "events"
      ]);
      allow delete: if false;
    }

    match /billingUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /push-devices/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /daily-task-reminders/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /billingOrders/{orderId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
