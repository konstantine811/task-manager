rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email in [
          "constainabrams@gmail.com",
          "constainabrams@gmial.com"
        ];
    }

    function billingDoc(uid) {
      return get(/databases/$(database)/documents/billingUsers/$(uid));
    }

    function hasBillingProfile(uid) {
      return exists(/databases/$(database)/documents/billingUsers/$(uid));
    }

    function hasTimestampField(doc, field) {
      return field in doc.data && doc.data[field] is timestamp;
    }

    function hasActiveTrial(uid) {
      return hasBillingProfile(uid) &&
        hasTimestampField(billingDoc(uid), "trialEndsAt") &&
        billingDoc(uid).data.trialEndsAt > request.time;
    }

    function hasActivePaidAccess(uid) {
      return hasBillingProfile(uid) &&
        hasTimestampField(billingDoc(uid), "accessEndsAt") &&
        billingDoc(uid).data.accessEndsAt > request.time;
    }

    function hasAdminAccess(uid) {
      return isAdminEmail() ||
        (
          hasBillingProfile(uid) &&
          "adminAccess" in billingDoc(uid).data &&
          billingDoc(uid).data.adminAccess == true
        );
    }

    function hasAppAccess(uid) {
      return isOwner(uid) &&
        (hasAdminAccess(uid) || hasActiveTrial(uid) || hasActivePaidAccess(uid));
    }

    function hasLegacyOwnerAccess(uid) {
      return isOwner(uid) && !hasBillingProfile(uid);
    }

    function canReadAppData(uid) {
      return isOwner(uid);
    }

    function canWriteAppData(uid) {
      return hasAppAccess(uid) || hasLegacyOwnerAccess(uid);
    }

    function validDayId(date) {
      return date.matches("^\\d{4}-\\d{2}-\\d{2}$") ||
        date.matches("^\\d{2}\\.\\d{2}\\.\\d{4}$");
    }

    function safeUserDocWrite() {
      return request.resource.data.keys().hasOnly([
        "email",
        "items",
        "updatedAt",
        "timerState",
        "timeZone",
        "timeZoneOffsetMinutes",
        "goals",
        "goalProgressEvents"
      ]);
    }

    function safeDayDocWrite() {
      return request.resource.data.keys().hasOnly([
        "email",
        "items",
        "updatedAt",
        "timerState",
        "timeZone",
        "timeZoneOffsetMinutes"
      ]);
    }

    match /node-writer/shared {
      match /folders/{folderId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }

      match /projects/{projectId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    match /template-tasks/{uid} {
      allow read: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && safeUserDocWrite();
      allow delete: if false;
    }

    match /daily-tasks/{uid}/days/{date} {
      allow get: if canReadAppData(uid) && validDayId(date);
      allow list: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if false;
    }

    match /planned-tasks/{uid}/days/{date} {
      allow get: if canReadAppData(uid) && validDayId(date);
      allow list: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if canWriteAppData(uid) && validDayId(date);
    }

    match /daily-analytics/{uid}/days/{date} {
      allow get: if canReadAppData(uid) && validDayId(date);
      allow list: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if false;
    }

    match /daily-journal/{uid}/days/{date} {
      allow get: if canReadAppData(uid) && validDayId(date);
      allow list: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if canWriteAppData(uid) && validDayId(date);
    }

    match /task-instances/{uid}/days/{date} {
      allow get: if canReadAppData(uid) && validDayId(date);
      allow list: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && validDayId(date) && safeDayDocWrite();
      allow delete: if false;
    }

    match /goals/{uid} {
      allow read: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && safeUserDocWrite();
      allow delete: if false;
    }

    match /goal-progress-events/{uid}/events/{eventId} {
      allow read, list: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && request.resource.data.keys().hasOnly([
        "email",
        "items",
        "updatedAt",
        "events"
      ]);
      allow delete: if false;
    }

    match /billingUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /push-devices/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /daily-task-reminders/{uid}/{document=**} {
      allow read, write: if false;
    }

    match /billingOrders/{orderId} {
      allow read, write: if false;
    }

    match /appDocs/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if hasAdminAccess(request.auth.uid);
    }

    match /socialProfiles/{uid} {
      allow read: if signedIn() && (isOwner(uid) || resource.data.visibility == "public");
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "emailLower",
        "displayName",
        "photoURL",
        "visibility",
        "showOnMap",
        "trackCurrentLocation",
        "city",
        "focusStatus",
        "activeTaskTitle",
        "showTaskTitle",
        "priority",
        "locationLat",
        "locationLng",
        "updatedAt",
        "createdAt"
      ]);
      allow delete: if isOwner(uid);
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == "pending";
      allow update: if signedIn() &&
        resource.data.toUid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "fromUid",
          "toUid",
          "fromEmail",
          "toEmail",
          "status",
          "createdAt",
          "updatedAt"
        ]);
      allow delete: if signedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
