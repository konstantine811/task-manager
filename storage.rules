rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email in [
          "constainabrams@gmail.com",
          "constainabrams@gmial.com"
        ];
    }

    function billingDoc(uid) {
      return firestore.get(/databases/(default)/documents/billingUsers/$(uid));
    }

    function hasBillingProfile(uid) {
      return firestore.exists(/databases/(default)/documents/billingUsers/$(uid));
    }

    function hasTimestampField(doc, field) {
      return field in doc.data && doc.data[field] is timestamp;
    }

    function hasActiveTrial(uid) {
      return hasBillingProfile(uid) &&
        hasTimestampField(billingDoc(uid), "trialEndsAt") &&
        billingDoc(uid).data.trialEndsAt > request.time;
    }

    function hasActivePaidAccess(uid) {
      return hasBillingProfile(uid) &&
        hasTimestampField(billingDoc(uid), "accessEndsAt") &&
        billingDoc(uid).data.accessEndsAt > request.time;
    }

    function hasAdminAccess(uid) {
      return isAdminEmail() ||
        (
          hasBillingProfile(uid) &&
          "adminAccess" in billingDoc(uid).data &&
          billingDoc(uid).data.adminAccess == true
        );
    }

    function hasAppAccess(uid) {
      return isOwner(uid);
    }

    function hasLegacyOwnerAccess(uid) {
      return isOwner(uid) && !hasBillingProfile(uid);
    }

    function canReadAppData(uid) {
      return isOwner(uid);
    }

    function canWriteAppData(uid) {
      return hasAppAccess(uid) || hasLegacyOwnerAccess(uid);
    }

    function planStorageLimitBytes(planId) {
      return planId == "pro"
        ? 5 * 1024 * 1024 * 1024
        : planId == "starter"
          ? 1024 * 1024 * 1024
          : 100 * 1024 * 1024;
    }

    function billingPlanId(uid) {
      return hasAdminAccess(uid) || hasActivePaidAccess(uid)
        ? rawBillingPlanId(uid)
        : "free";
    }

    function rawBillingPlanId(uid) {
      return !hasBillingProfile(uid)
        ? "free"
        : "planId" in billingDoc(uid).data
        ? billingDoc(uid).data.planId
        : "plan" in billingDoc(uid).data &&
        billingDoc(uid).data.plan is map &&
        "id" in billingDoc(uid).data.plan
        ? billingDoc(uid).data.plan.id
        : "id" in billingDoc(uid).data
          ? billingDoc(uid).data.id
          : "free";
    }

    function currentStorageBytes(uid) {
      return hasBillingProfile(uid) &&
        "storageBytes" in billingDoc(uid).data &&
        billingDoc(uid).data.storageBytes is number
        ? billingDoc(uid).data.storageBytes
        : 0;
    }

    function hasStorageCapacity(uid) {
      return hasAdminAccess(uid) ||
        currentStorageBytes(uid) + request.resource.size <=
        planStorageLimitBytes(billingPlanId(uid));
    }

    function isImageUpload() {
      return request.resource != null &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches("image/.*");
    }

    match /node-writer/shared/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminEmail();
    }

    match /task-manager-life-focus/{uid}/daily-journal-images/{date}/{fileName} {
      allow read: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && isImageUpload() && hasStorageCapacity(uid);
      allow delete: if isOwner(uid);
    }

    match /task-manager-life-focus/{uid}/profile/avatar {
      allow read: if canReadAppData(uid);
      allow create, update: if isOwner(uid) && isImageUpload();
      allow delete: if isOwner(uid);
    }

    match /app-docs/guide/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if hasAdminAccess(request.auth.uid) && isImageUpload();
    }

    match /{uid}/daily-journal-images/{date}/{fileName} {
      allow read: if canReadAppData(uid);
      allow create, update: if canWriteAppData(uid) && isImageUpload() && hasStorageCapacity(uid);
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
