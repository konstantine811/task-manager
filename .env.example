# Firebase client config (required)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Web push notifications (required if push notifications are enabled)
VITE_FIREBASE_VAPID_KEY=

# Backend proxy for AI and billing endpoints (required for AI/billing flows)
VITE_AI_PROXY_URL=

# Public site URL used in legal pages and payment metadata
VITE_PUBLIC_SITE_URL=

# Pricing shown in the app
VITE_STARTER_PRICE_UAH=
VITE_PRO_PRICE_UAH=

# Portmone checkout page
# Do not put Portmone login/password in frontend env files.
VITE_PORTMONE_PAYEE_ID=
VITE_PORTMONE_GATEWAY_URL=https://www.portmone.com.ua/gateway/
VITE_PORTMONE_STARTER_AMOUNT_UAH=
VITE_PORTMONE_PRO_AMOUNT_UAH=

# Merchant/legal details shown in legal pages
VITE_MERCHANT_LEGAL_NAME=
VITE_MERCHANT_TAX_ID=
VITE_MERCHANT_LEGAL_ADDRESS=
VITE_MERCHANT_ACTUAL_ADDRESS=
VITE_MERCHANT_EMAIL=
VITE_MERCHANT_PHONE=
VITE_MERCHANT_IBAN=
VITE_MERCHANT_BANK=

# Optional integrations
VITE_MAPBOX_TOKEN=
VITE_SENTRY_DSN=
